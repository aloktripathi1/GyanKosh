      "updated": 1,
      "link": null,
      "locked": false,
      "text": "POST /documents (validate: type, magic bytes, size, non-empty; dedupe by content hash)\nGET /jobs \u00b7 GET /jobs/{id} \u00b7 DELETE /jobs/{id} \u00b7 GET /jobs/{id}/stream (SSE)\nGET /tkp/{id} \u00b7 POST /tkp/{id}/regenerate/{section} (row-locked)   \u00b7   GET /files/{path} (signed URL)\nmiddleware: CORS, API-key auth",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rect_7",
      "originalText": "POST /documents (validate: type, magic bytes, size, non-empty; dedupe by content hash)\nGET /jobs \u00b7 GET /jobs/{id} \u00b7 DELETE /jobs/{id} \u00b7 GET /jobs/{id}/stream (SSE)\nGET /tkp/{id} \u00b7 POST /tkp/{id}/regenerate/{section} (row-locked)   \u00b7   GET /files/{path} (signed URL)\nmiddleware: CORS, API-key auth",
      "lineHeight": 1.25,
      "baseline": 15
    },
